# ── Supabase (client project: xhgybcyvpasmtlpscdly) ───────────────────────────
# Browser URL + publishable key are also in src/config/supabase-public.ts.
# Get keys from: https://supabase.com/dashboard → Project Settings → API
#
# Server (.env required for billing, admin, webhooks):
SUPABASE_PROJECT_ID="your_project_id"
SUPABASE_PUBLISHABLE_KEY="your_publishable_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key"
SUPABASE_URL="https://your-project.supabase.co"
#
# Client (optional at build time — also injected at runtime from SUPABASE_* above):
VITE_SUPABASE_PROJECT_ID="your_project_id"
VITE_SUPABASE_PUBLISHABLE_KEY="your_publishable_anon_key"
VITE_SUPABASE_URL="https://your-project.supabase.co"

# ── Stripe ────────────────────────────────────────────────────────────────────
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_YOUR_SECRET_KEY_HERE"
STRIPE_WEBHOOK_SECRET="whsec_YOUR_WEBHOOK_SECRET_HERE"
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_YOUR_PUBLISHABLE_KEY_HERE"
APP_URL="http://localhost:3000"

# ── Agora (video/audio calls) ─────────────────────────────────────────────────
# Get these from: https://console.agora.io
AGORA_APP_ID="your_agora_app_id"
AGORA_APP_CERTIFICATE="your_agora_certificate_or_TESTING_NO_CERT"

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="your_vapid_public_key"
VAPID_PRIVATE_KEY="your_vapid_private_key"
VAPID_EMAIL="mailto:admin@yourdomain.com"
VITE_VAPID_PUBLIC_KEY="your_vapid_public_key"

# ── Resend (transactional email) ──────────────────────────────────────────────
# Get from: https://resend.com/api-keys
RESEND_API_KEY="re_YOUR_API_KEY_HERE"
